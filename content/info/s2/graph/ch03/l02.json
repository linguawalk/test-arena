      "code": "// 1단계: 원래 그래프에서 DFS, 끝나는 순서를 fin에 기록\nvoid dfs1(int u) {\n    vis[u] = true;\n    for (int v : adj[u]) if (!vis[v]) dfs1(v);\n    fin.push_back(u);\n}\n// 2단계: 간선을 뒤집은 그래프 radj에서, fin의 뒤쪽(늦게 끝난 정점)부터 DFS\nvoid dfs2(int u, int c) {\n    comp[u] = c;\n    for (int v : radj[u]) if (comp[v] == 0) dfs2(v, c);\n}\n// for (int i = n - 1, c = 0; i >= 0; i--) if (comp[fin[i]] == 0) dfs2(fin[i], ++c);"
