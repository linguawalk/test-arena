    {
      "type": "question",
      "id": "r5",
      "stage": "review",
      "qtype": "numeric",
      "prompt": "그림의 S에 아래 코드를 실행하면 low[6]은?",
      "answer": "4",
      "answer_format": "integer",
      "tolerance": 0,
      "hint": "6의 자식 7의 low는 4입니다.",
      "explanation": "6은 자식 7을 방문하고 돌아와 low[6] = min(low[6], low[7])입니다.\nlow[7] = dfn[5] = 4입니다.\n그래서 low[6] = 4입니다.",
      "code": "int dfn[MAXN], low[MAXN], t = 0;      // dfn: 방문 순서 번호, low: 닿을 수 있는 가장 작은 dfn\nstack<int> st; bool onSt[MAXN];\nvoid dfs(int u) {\n    dfn[u] = low[u] = ++t;\n    st.push(u); onSt[u] = true;\n    for (int v : adj[u]) {\n        if (dfn[v] == 0) { dfs(v); low[u] = min(low[u], low[v]); }\n        else if (onSt[v]) low[u] = min(low[u], dfn[v]);   // 스택에 있는 정점만\n    }\n    if (low[u] == dfn[u]) {            // u가 SCC의 뿌리\n        while (true) {\n            int x = st.top(); st.pop(); onSt[x] = false;\n            comp[x] = u;\n            if (x == u) break;\n        }\n    }\n}",
